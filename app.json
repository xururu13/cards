{
  "expo": {
    "name": "Карточки",
    "slug": "cards",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cards",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kartochki.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E70ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kartochki.app",
      "versionCode": 14
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E70ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Микрофон нужен, чтобы диктовать карточки голосом.",
          "speechRecognitionPermission": "Распознавание речи превращает диктовку в текст карточки.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Камера нужна, чтобы сфотографировать текст для карточки.",
          "photosPermission": "Доступ к фото нужен, чтобы взять текст для карточки из снимка.",
          "microphonePermission": "Микрофон нужен, чтобы диктовать карточки голосом."
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-maven-mirror"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
