# Скопируйте в .env.local (он не попадает в git) и заполните.
# После изменения перезапустите сервер разработки: npx expo start --dev-client --clear
#
# Внимание: значения EXPO_PUBLIC_* встраиваются в приложение — ключ можно извлечь из APK.

# Адрес OpenAI-совместимого API (обычно заканчивается на /v1)
EXPO_PUBLIC_AI_BASE_URL=https://example.com/v1
# Название модели, которая умеет читать изображения
EXPO_PUBLIC_AI_MODEL=qwen-3.8-27b
# Ключ доступа
EXPO_PUBLIC_AI_API_KEY=
